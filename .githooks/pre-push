#!/bin/sh
# Refuse to push a v* tag whose version differs from the one in
# quad_retopo/blender_manifest.toml at the tagged commit.
# Enable once per clone:  git config core.hooksPath .githooks

manifest=quad_retopo/blender_manifest.toml
zero=0000000000000000000000000000000000000000
status=0

while read -r local_ref local_sha remote_ref remote_sha; do
  case "$local_ref" in
    refs/tags/v*) ;;
    *) continue ;;
  esac
  [ "$local_sha" = "$zero" ] && continue   # tag deletion

  tag=${local_ref#refs/tags/}
  version=$(git show "${local_sha}^{commit}:$manifest" 2>/dev/null \
    | sed -nE 's/^version *= *"([^"]+)".*/\1/p')

  if [ "v$version" != "$tag" ]; then
    echo "pre-push: tag $tag does not match $manifest version '$version'." >&2
    echo "  Bump 'version' to ${tag#v}, commit, then re-tag:" >&2
    echo "    git tag -d $tag && git tag $tag" >&2
    status=1
  fi
done

exit $status
